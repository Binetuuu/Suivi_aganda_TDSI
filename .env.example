# Copiez ce fichier en .env et adaptez les valeurs. Ne publiez jamais le fichier .env.

# Clé secrète longue et aléatoire (python -c "import secrets; print(secrets.token_hex(32))")
TDSI_SECRET_KEY=

# Base de données (SQLite par défaut ; PostgreSQL possible : postgresql+psycopg://user:mdp@hote/tdsi)
# TDSI_DATABASE_URL=sqlite:///tdsi.db

# Code de confirmation envoyé par e-mail à la connexion (1 = activé, 0 = mot de passe seul)
TDSI_OTP=1

# --- Envoi des e-mails ---------------------------------------------------------
# console = les e-mails sont seulement affichés dans le terminal (tests)
# smtp    = envoi réel
TDSI_NOTIF_BACKEND=console

# Exemple gratuit avec Gmail (environ 500 e-mails par jour) :
#   1. Activez la validation en deux étapes sur le compte Gmail de l'école/classe.
#   2. Créez un « mot de passe d'application » : https://myaccount.google.com/apppasswords
#   3. Collez-le ci-dessous (16 lettres, sans espaces) et passez TDSI_NOTIF_BACKEND à smtp.
TDSI_SMTP_HOST=smtp.gmail.com
TDSI_SMTP_PORT=587
TDSI_SMTP_USER=
TDSI_SMTP_PASSWORD=
# Laisser vide pour utiliser l'adresse TDSI_SMTP_USER comme expéditeur
TDSI_SMTP_FROM=

# Ou bien Brevo (gratuit, API HTTPS) : TDSI_NOTIF_BACKEND=brevo
TDSI_BREVO_API_KEY=
TDSI_EMAIL_EXPEDITEUR=

# Mettre 1 en production (site servi en HTTPS)
TDSI_COOKIE_SECURE=0

TDSI_SEUIL_ALERTE=85
TDSI_INDICATIF=+221
